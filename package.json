{
  "name": "kulon-creator",
  "version": "1.0.1",
  "description": "",
  "scripts": {
    "serve": "http-server ./public -p 9001 -d false -o index.html -c-1 --silent",
    "build": "npx tsx src/build-prerequisite.ts && npx --node-options=\"--import tsx\" webpack --disable-interpret --config src/webpack.prod.ts",
    "dev": "npx --node-options=\"--import tsx\" webpack --disable-interpret --config src/webpack.dev.ts",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "type-check": "tsc -p . --pretty --noEmit",
    "lint": "eslint --ext ts --ext js",
    "test": "npm run lint && npm run type-check && npm run format",
    "up:patch": "npm --no-git-tag-version version patch",
    "up:minor": "npm --no-git-tag-version version minor",
    "up:major": "npm --no-git-tag-version version major",
    "prepatch": "npm --no-git-tag-version version prepatch && npm --no-git-tag-version version prerelease --preid wip",
    "preminor": "npm --no-git-tag-version version preminor && npm --no-git-tag-version version prerelease --preid wip",
    "premajor": "npm --no-git-tag-version version premajor && npm --no-git-tag-version version prerelease --preid wip",
    "prerelease": "npm --no-git-tag-version version prerelease",
    "postinstall": "npx tsx src/build-prerequisite.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiccupsRaven/Kulon-Creator.git"
  },
  "keywords": [],
  "author": "Devanka761 <contact@devanka.id> (https://devanka.id/)",
  "license": "SEE LICENSE IN LICENSE",
  "private": "true",
  "bugs": {
    "url": "https://github.com/HiccupsRaven/Kulon-Creator/issues"
  },
  "homepage": "https://github.com/HiccupsRaven/Kulon-Creator#readme",
  "dependencies": {
    "esbuild-wasm": "^0.28.1",
    "monaco-editor": "^0.55.1",
    "screenfull": "^6.0.2",
    "webfont-awesome-pro": "1.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.5",
    "pretty-quick": "^4.2.2",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}

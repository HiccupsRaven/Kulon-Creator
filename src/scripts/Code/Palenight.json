  "rules": [
    {
      "token": "variable.predefined",
      "foreground": "#FF5874"
    },
    {
      "token": "constant",
      "foreground": "#80CBC4"
    },
    {
      "token": "number",
      "foreground": "#008080"
    },
    {
      "token": "number.hex",
      "foreground": "#008080"
    },
    {
      "token": "regexp",
      "foreground": "#80CBC4"
    },
    {
      "token": "annotation",
      "foreground": "#808080"
    },
    {
      "token": "type",
      "foreground": "#FFCB6B"
    },
    {
      "token": "delimiter.html",
      "foreground": "#383838"
    },
    {
      "token": "delimiter.xml",
      "foreground": "#0000FF"
    },
    {
      "token": "tag",
      "foreground": "#FF5874"
    },
    {
      "token": "tag.id.jade",
      "foreground": "#4F76AC"
    },
    {
      "token": "tag.class.jade",
      "foreground": "#4F76AC"
    },
    {
      "token": "meta.scss",
      "foreground": "#FF5874"
    },
    {
      "token": "metatag",
      "foreground": "#FF5874"
    },
    {
      "token": "metatag.content.html",
      "foreground": "#FF5874"
    },
    {
      "token": "metatag.html",
      "foreground": "#808080"
    },
    {
      "token": "metatag.xml",
      "foreground": "#808080"
    },
    {
      "token": "key",
      "foreground": "#863B00"
    },
    {
      "token": "string.key.json",
      "foreground": "#A31515"
    },
    {
      "token": "string.value.json",
      "foreground": "#0451A5"
    },
    {
      "token": "attribute.name",
      "foreground": "#FF0000"
    },
    {
      "token": "attribute.value",
      "foreground": "#0451A5"
    },
    {
      "token": "attribute.value.number",
      "foreground": "#008080"
    },
    {
      "token": "attribute.value.unit",
      "foreground": "#008080"
    },
    {
      "token": "attribute.value.html",
      "foreground": "#0000FF"
    },
    {
      "token": "attribute.value.xml",
      "foreground": "#0000FF"
    },
    {
      "token": "string.html",
      "foreground": "#0000FF"
    },
    {
      "token": "string.sql",
      "foreground": "#FF0000"
    },
    {
      "token": "string.yaml",
      "foreground": "#0451A5"
    },
    {
      "token": "keyword.json",
      "foreground": "#0451A5"
    },
    {
      "token": "keyword.flow",
      "foreground": "#FF5874"
    },
    {
      "token": "keyword.flow.scss",
      "foreground": "#0000FF"
    },
    {
      "token": "operator.scss",
      "foreground": "#666666"
    },
    {
      "token": "operator.sql",
      "foreground": "#778899"
    },
    {
      "token": "operator.swift",
      "foreground": "#666666"
    },
    {
      "token": "predefined.sql",
      "foreground": "#FF00FF"
    },
    {
      "token": "attribute.value.number.css",
      "foreground": "#B5CEA8"
    },
    {
      "token": "attribute.value.unit.css",
      "foreground": "#B5CEA8"
    },
    {
      "token": "attribute.value.hex.css",
      "foreground": "#D4D4D4"
    },
    {
      "token": "meta",
      "foreground": "#D4D4D4"
    },
    {
      "token": "string.key",
      "foreground": "#9CDCFE"
    },
    {
      "token": "string.value",
      "foreground": "#CE9178"
    },
    {
      "token": "comment",
      "foreground": "#697098",
      "fontStyle": "italic"
    },
    {
      "token": "string",
      "foreground": "#C3E88D"
    },
    {
      "token": "variable",
      "foreground": "#008080"
    },
    {
      "token": "keyword",
      "foreground": "#9684ec"
    },
    {
      "token": "variable.parameter",
      "foreground": "#7986E7"
    },
    {
      "token": "meta.tag",
      "foreground": "#89DDFF"
    },
    {
      "token": "invalid",
      "background": "#FF2C83",
      "foreground": "#FFFFFF"
    }
  ]
}
